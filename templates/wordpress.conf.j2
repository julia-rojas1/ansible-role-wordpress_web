<VirtualHost *:{{ wp_port }}>
    ServerName {{ wp_server_name }}
    DocumentRoot {{ wp_install_dir }}

    <Directory {{ wp_install_dir }}>
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog /var/log/{{ web_service_name }}/wordpress_error.log
    CustomLog /var/log/{{ web_service_name }}/wordpress_access.log combined
</VirtualHost>
